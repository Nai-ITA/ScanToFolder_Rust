{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ScanToFolder",
  "version": "2.0.0",
  "identifier": "it.naict.scantofolder",
  "build": { "frontendDist": "../src" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "Scan to Folder", "width": 760, "height": 820, "minWidth": 420, "minHeight": 560, "visible": false, "center": true }
    ],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self'" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Scan to Folder",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "linux": { "deb": { "depends": ["libayatana-appindicator3-1"] } },
    "macOS": { "minimumSystemVersion": "11.0", "signingIdentity": "-" }
  }
}
